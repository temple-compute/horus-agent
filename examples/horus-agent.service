# Hardened system unit for horus-agent; setup in the README, "Run it as a
# system service". Tasks inherit every restriction below.
#
#   cp examples/horus-agent.service /etc/systemd/system/
#   systemctl enable --now horus-agent
[Unit]
Description=Horus agent
After=network-online.target
Wants=network-online.target

[Service]
User=horus-agent
Group=horus-agent
# -I: import nothing from the environment or a writable directory.
ExecStart=/opt/horus-agent/bin/python -I -m horus_agent run
Environment=HORUS_AGENT_CONFIG=/var/lib/horus-agent/agent.json
StateDirectory=horus-agent
StateDirectoryMode=0700
UMask=0077
Restart=always
RestartSec=10
# Jobs run in their own sessions and outlive the agent; only stop the agent.
KillMode=process
# The agent finishes the ops it started before exiting.
TimeoutStopSec=120

NoNewPrivileges=yes
# Tasks as another user, or rootless Podman: add a drop-in from
# examples/horus-agent.service.d/.
CapabilityBoundingSet=
ProtectSystem=strict
# The work dir: the only place the agent and its tasks can write. The agent
# refuses to start if its work_dir is not under it.
ReadWritePaths=/srv/horus-agent
ProtectHome=read-only
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
